# Copy this file to .env and fill in the real values.
#
# These are the exact same URL and anon key the web app's Vercel
# project already has as NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY - same Supabase project, same
# database, same user accounts. Find them in Vercel's project
# settings (Environment Variables) or Supabase's own dashboard
# (Project Settings > API).
#
# The EXPO_PUBLIC_ prefix (rather than NEXT_PUBLIC_) is Expo's own
# convention for "safe to ship in the client bundle" - same idea,
# different framework's naming.

EXPO_PUBLIC_SUPABASE_URL=https://egdghdutgjcdvhazmblw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
