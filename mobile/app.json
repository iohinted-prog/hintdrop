{
  "expo": {
    "name": "HintDrop",
    "slug": "hintdrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ff875d",
    "scheme": "hintdrop",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "app.hintdrop.mobile",
      "supportsTablet": true,
      "associatedDomains": ["applinks:hintdrop.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hintdrop.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ff875d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "hintdrop.app", "pathPrefix": "/b" },
            { "scheme": "https", "host": "hintdrop.app", "pathPrefix": "/h" },
            { "scheme": "https", "host": "hintdrop.app", "pathPrefix": "/profile" },
            { "scheme": "https", "host": "hintdrop.app", "pathPrefix": "/join" },
            { "scheme": "https", "host": "hintdrop.app", "pathPrefix": "/invite" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21cbf096-b46a-44e8-a708-ab684c78c3fb"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ff875d"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HintDrop needs access to your photos so you can add one to a hint."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "21cbf096-b46a-44e8-a708-ab684c78c3fb"
      }
    },
    "owner": "hintdrop.app"
  }
}
