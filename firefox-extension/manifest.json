{
  "manifest_version": 3,
  "name": "HintDrop",
  "version": "0.10.0",
  "description": "Save gift ideas straight from any product page.",
  "permissions": ["activeTab", "scripting", "storage", "cookies"],
  "host_permissions": [
    "https://egdghdutgjcdvhazmblw.supabase.co/*",
    "https://hintdrop.app/*",
    "https://www.hintdrop.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://hintdrop.app/*", "https://www.hintdrop.app/*"],
      "js": ["detectInstalled.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@hintdrop.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  }
}
